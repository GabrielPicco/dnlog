# ============================================================
# DNLog Backend — Configuração de ambiente
# ============================================================
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente

# Porta do backend (onde o DNLog vai conectar)
PORT=3000

# ----- MODO DE OPERAÇÃO -----
# true  = usa mock do SAP (dados fake, ideal pra desenvolvimento)
# false = conecta no Service Layer SAP REAL
USE_MOCK=false

# ----- SOMENTE LEITURA (TRAVA DE SEGURANÇA) -----
# O DNLog é SOMENTE LEITURA no SAP. Duas travas independentes (ambas off):
# 1) SAP_READ_ONLY=true       -> bloqueia escrita no nível do método.
# 2) SAP_ENABLE_WRITES=false  -> bloqueia escrita na camada de REDE (POST/etc).
# Para escrever é preciso ligar AS DUAS (decisão deliberada, só homologação).
SAP_READ_ONLY=true
SAP_ENABLE_WRITES=false

# ----- CONFIGURAÇÕES DO SAP SERVICE LAYER (só usado se USE_MOCK=false) -----
# URL do Service Layer (produção, mesma do BI_DNSEEDS)
SAP_SERVICE_LAYER_URL=https://sap-dnseeds-sl.skyinone.net:50000/b1s/v1

# Nome da CompanyDB
SAP_COMPANY_DB=SBODNSPRD

# Credenciais do usuário de integração (leitura)
SAP_USERNAME=int_dnseeds
# Coloque a senha ENTRE ASPAS (se tiver '#' ou outro caractere especial, sem
# aspas o dotenv corta o valor).
SAP_PASSWORD="alterar_aqui"

# Idioma do login (23 = Português Brasil). Evita "Switch company error".
SAP_LANGUAGE=23

# Se o SAP usar certificado autoassinado, deixe true
SAP_IGNORE_SSL_ERRORS=true

# ----- BANCO DE DADOS -----
# Onde as Ordens de Embarque (OE) são persistidas.
# DB_TYPE=sqlite  -> arquivo local (data/dnlog.db). Padrão, zero instalação.
# DB_TYPE=postgres -> banco PostgreSQL (produção/SkyOne).
DB_TYPE=sqlite

# --- SQLite (só usado se DB_TYPE=sqlite) ---
DB_DATABASE=data/dnlog.db

# --- PostgreSQL (só usado se DB_TYPE=postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=dnlog
DB_PASSWORD=alterar_aqui
DB_NAME=dnlog
DB_SSL=false

# Cria/atualiza as tabelas automaticamente a partir das entidades.
# true é prático no protótipo; em produção com Postgres, use migrations.
DB_SYNCHRONIZE=true

# ----- CORS -----
# URL do frontend que vai consumir esse backend (DNLog)
# Use * em desenvolvimento; em produção, especifique o domínio
# (aceita múltiplas origens separadas por vírgula)
CORS_ORIGIN=*

# ----- AUTENTICAÇÃO DA API -----
# Chave exigida no header "x-api-key" para acessar a API (exceto /health).
# Deixe VAZIO em desenvolvimento (autenticação desligada, com aviso no log).
API_KEY=

# ----- LOGIN DE USUÁRIOS (Google @dnseeds.com.br + aprovação) -----
GOOGLE_CLIENT_ID=398250143881-hj0sn14ihmruftegg7i0apc56h6u4fsj.apps.googleusercontent.com
GOOGLE_AUTHORIZED_DOMAIN=dnseeds.com.br
ADMIN_EMAIL=gabriel@dnseeds.com.br
JWT_SECRET=troque-por-um-segredo-aleatorio-longo
# Login de teste sem Google (deixe false depois que o Google estiver configurado).
AUTH_BYPASS=false
# Pasta do app servido (dnlog-backend/public/index.html).
DNLOG_PUBLIC_DIR=public
